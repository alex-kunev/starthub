# Weather widget uses Open-Meteo (no API key needed).
# Coordinates and label are set in lib/config.ts — edit that file directly.

# Calendar widget: URL of the calendar-proxy service (see server/calendar-proxy.js).
NEXT_PUBLIC_CALENDAR_API_URL=http://localhost:4001/events

# Mountain photo widget: Unsplash API access key (https://unsplash.com/developers).
# Leave blank to show a "not configured" placeholder instead.
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# calendar-proxy service configuration (used by `npm run calendar-proxy`, not by the Next.js app itself)
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# PORT=4001
# CALENDAR_ALLOWED_ORIGIN=http://localhost:3000
